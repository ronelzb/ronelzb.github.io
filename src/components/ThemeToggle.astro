---

<button
  type="button"
  class="theme-toggle"
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Toggle theme"
>
  <svg
    class="theme-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <circle class="theme-icon-ring" cx="10" cy="10" r="6.75"></circle>
    <path class="theme-icon-phase" d="M10 3.25a6.75 6.75 0 0 1 0 13.5 3.65 6.75 0 0 0 0-13.5Z"
    ></path>
  </svg>
</button>

<script is:inline>
  (function () {
    function mount() {
      var root = document.documentElement;

      document.querySelectorAll('.theme-toggle:not([data-ready])').forEach(function (btn) {
        btn.dataset.ready = 'true';

        function syncLabel(dark) {
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          btn.setAttribute('aria-pressed', String(dark));
        }

        syncLabel(root.getAttribute('data-bs-theme') === 'dark');

        new MutationObserver(function () {
          syncLabel(root.getAttribute('data-bs-theme') === 'dark');
        }).observe(root, { attributes: true, attributeFilter: ['data-bs-theme'] });

        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-bs-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (_) {}
          syncLabel(next === 'dark');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mount, { once: true });
    } else {
      mount();
    }
  })();
</script>

<style>
  .theme-toggle {
    align-items: center;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    opacity: 0.8;
    padding: 0;
    transition: opacity var(--duration-fast, 150ms) var(--ease-out, ease);
    width: 2rem;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .theme-toggle:focus-visible {
    border-radius: 4px;
    outline: 1px solid currentcolor;
    outline-offset: 0.25rem;
  }

  .theme-icon {
    display: block;
    transition: transform var(--duration-normal, 250ms) var(--ease-out, ease);
  }

  .theme-icon-ring {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.45;
  }

  .theme-icon-phase {
    fill: currentcolor;
    opacity: 0.62;
    transform-origin: center;
    transition: opacity var(--duration-fast, 150ms) var(--ease-out, ease);
  }
</style>

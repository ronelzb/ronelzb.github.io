function starIcon(val: true | false | 'half'): string {
  if (val === true) return 'fas fa-star';
  if (val === 'half') return 'fas fa-star-half-alt';
  return 'far fa-star';
}
---

<PageLayout
  title="About"
  aboutTitle="Ronel Zapata"
  aboutSubtitle="Hey, I'm"
  headerImg="/images/image-avatar.webp"
  largeHeader={true}
>
  <section class="about-me bg-light py-4">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <h2 class="text-center">About me</h2>
          <p set:html={aboutMe} />
        </div>
        <div class="col-12 col-md-6">
          <h4 class="border-bottom border-secondary">Fun Facts</h4>
          <ul class="facts">
            {facts.map((fact) => <li set:html={fact} />)}
          </ul>
        </div>
        <div class="col-12 col-md-6">
          <h4 class="border-bottom border-secondary">Skill set</h4>
          <ul class="skills text-center text-md-start">
            {
              skills.map((skill) => (
                <li>
                  <span class="skill text-center text-white fw-bold rounded d-inline-block px-2 py-1">
                    {skill.name}
                  </span>
                  {skill.rating.map((val) => (
                    <i class={`${starIcon(val)} align-middle text-secondary skill-rating`} />
                  ))}
                </li>
              ))
            }
          </ul>
          <div class="text-center text-md-start mt-0 mt-md-5 resume">
            <a href="/resume.pdf" target="_blank">
              View Resume<i class="fas fa-file-pdf fa-lg ms-3 align-middle"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline mb-3">
    <div class="container">
      <div class="row">
        <div class="col text-center mt-2 mt-md-3">
          <h2>My journey</h2>
          <ul class="m-0 p-0 w-50">
            {
              timeline.map((event) => (
                <li class={`my-4 position-relative ${event.position}`}>
                  <p class="p-3 rounded text-center" set:html={event.text} />
                  <span class="position-absolute fw-bold text-info">{event.date}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

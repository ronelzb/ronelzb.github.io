---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/about.css';

const aboutMe =
  "Hi, my name is Ronel José Zapata Beltrán. I'm a Senior Software Engineer with 17+ years working on data analytics " +
  'and business intelligence software solutions delivering impactful, robust and reliable engineering products in ' +
  'the oil, energy, and healthcare fields, working in projects with companies of all sizes and shape.' +
  '<br /><br />' +
  'I love getting involved in new challenging projects using cutting edge technologies, getting out of my comfort ' +
  'zone. I hold a degree in Computer Engineering from Universidad de Oriente in Venezuela and several ' +
  'certifications on SQL Server, Azure and .NET development. My hobby is Taekwondo, training since 26 years ago to this day.';

const facts = [
  'The first computer I was in contact with was a <a href="https://en.wikipedia.org/wiki/Intel_80386" target="_blank">80386</a> which ran MS-DOS and video games like Wolf3d and Prince of Persia.',
  'Every time when turning on my first PC I was so curious on how a lifeless object could <b>think</b>, since then I voyaged in the adventure of knowing more about it and my passion about computers only grew ever since.',
  "Back in 2006, I had the priviledge of training Taekwondo with Adriana Carmona (Olympic gold medal in Barcelona '92) and the Venezuela national selection for a short time.",
  'For me, study and train any sport are essential and a never-ending cycle.',
  'I am a dual citizen of México and Venezuela.',
];

const skills = [
  { name: 'Python', rating: [true, true, true, true, 'half'] },
  { name: '.NET (C#, VB)', rating: [true, true, true, true, 'half'] },
  { name: 'Java', rating: [true, true, true, true, false] },
  { name: 'PostgreSQL', rating: [true, true, true, true, false] },
  { name: 'SQL Server', rating: [true, true, true, true, false] },
  { name: 'Oracle', rating: [true, true, true, 'half', false] },
  { name: 'HTML/CSS', rating: [true, true, true, true, false] },
  { name: 'JS (JQuery)', rating: [true, true, true, true, 'half'] },
] as const;


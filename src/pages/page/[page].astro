---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import avatarImage from '../../images/image-avatar.webp';
import mainBanner from '../../images/main-banner.webp';
import '../../styles/posts.css';

export const getStaticPaths = (async ({ paginate }) => {
  const posts: CollectionEntry<'blog'>[] = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(sorted, { pageSize: 5 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;

function getExcerpt(body: string, wordCount = 50): string {
  const text = body
    .replace(/^#{1,6}\s+.+$/gm, '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/`{1,3}[\s\S]*?`{1,3}/g, '')
    .replace(/[*_~]{1,3}([^*_~]+)[*_~]{1,3}/g, '$1')
    .replace(/<!--[\s\S]*?-->/g, '')
    .trim();
  const words = text.split(/\s+/).filter(Boolean);
  return words.slice(0, wordCount).join(' ') + (words.length > wordCount ? '...' : '');
}

function toSlug(raw: string): string {
  return raw.replace(/^(\d{4})-(\d{2})-(\d{2})-/, '$1/$2/$3/');
}

const SIDEBAR_QUOTE =
  "Dreams don't work unless you take action. The surest way to make your dreams come true is to live them. — Roy T. Bennett";

const prevHref = page.currentPage === 2 ? '/' : page.url.prev;
---

<PageLayout
  title="Ronel Zapata"
  description="Senior Software Engineer, coding exercises and projects on GitHub"
  headerImg={mainBanner}
>
  <section class="main-container">
    <div class="container">
      <div class="row">
        <div class="col-12 col-md-8 main-content mt-2 mt-md-3">
          <h2 class="intro-header">Coding exercises and projects on GitHub</h2>

          {
            page.data.map((post) => {
              const slug = toSlug(post.id);
              const dateStr = post.data.date.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              });
              return (
                <div class="post-preview">
                  <a href={`/${slug}`}>
                    <h2 class="post-title">{post.data.title}</h2>
                    {post.data.subtitle && <h3 class="post-subtitle">{post.data.subtitle}</h3>}
                  </a>
                  <p class="post-meta">Posted on {dateStr}</p>
                  <p>{getExcerpt(post.body ?? '')}</p>
                  <a href={`/${slug}`} class="post-read-more">
                    Read More &rarr;
                  </a>
                </div>
              );
            })
          }

          <ul class="pagination mt-4 p-0">
            {
              prevHref && (
                <li class="page-item previous">
                  <a class="page-link" href={prevHref}>
                    &larr; Newer Posts
                  </a>
                </li>
              )
            }
            {
              page.url.next && (
                <li class="page-item next">
                  <a class="page-link" href={page.url.next}>
                    Older Posts &rarr;
                  </a>
                </li>
              )
            }
          </ul>
        </div>

        <div class="col-12 col-md-4 sidebar-container mt-2 mt-md-3">
          <div class="short-about">
            <Image src={avatarImage} alt="Ronel Zapata" loading="lazy" />
            <p>{SIDEBAR_QUOTE}</p>
            <hr />
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
